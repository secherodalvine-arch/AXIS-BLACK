MONGODB_URI=mongodb://localhost:27017
DB_NAME=axis_black_db
GEMINI_API_KEY=
PORT=8000
HOST=127.0.0.1

# JWT Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# CORS Allowed Origins (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://axis-black.onrender.com

# ─── Frontend URL ──────────────────────────────────────────────────────────────
# This URL is embedded in verification and password-reset email links.
# Set this to your deployed frontend URL (e.g. https://your-app.vercel.app).
# For local dev, use http://localhost:5173
# If you host frontend + backend together on Render, use the Render service URL.
FRONTEND_URL=http://localhost:5173

# ─── Vercel Email API ──────────────────────────────────────────────────────────
# Deployed Vercel serverless email API base URL (must be HTTPS in production)
EMAIL_API_URL=https://your-email-api.vercel.app
EMAIL_API_KEY=your-secure-random-token

# ─── Support Email ─────────────────────────────────────────────────────────────
SUPPORT_EMAIL=secherodalvine@gmail.com

# ─── Cloudinary (optional – for image uploads) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── ElevenLabs Voice Agent ────────────────────────────────────────────────────
ELEVENLABS_AGENT_ID=
ELEVENLABS_API_KEY=

# ─── Admin Platform Configuration ───────────────────────────────────────────────
# Administrator credentials & security (loaded into backend memory/DB on startup)
ADMIN_DEFAULT_EMAIL=admin@axisblack.com
ADMIN_DEFAULT_PASSWORD=ChangeThisPassword123!
ADMIN_DEFAULT_NAME=Axis Administrator
ADMIN_INVITE_CODE=AXIS-ADMIN-2026
ADMIN_JWT_SECRET=generate-a-strong-secret-key-here
ADMIN_JWT_EXPIRE_HOURS=72
